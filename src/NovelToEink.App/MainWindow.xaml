<Window x:Class="NovelToEink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:NovelToEink.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NovelToEink.App"
        mc:Ignorable="d"
        Title="Novel To Xteink"
        Height="1040" Width="1400" MinHeight="700" MinWidth="1100"
        Background="{DynamicResource AppBg}" FontFamily="Yu Gothic UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel>
                <TextBlock Text="Novel To Xteink" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{loc:Loc app_desc}"
                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource Ghost}" Padding="10,6" Content="{loc:Loc export_btn}" Margin="0,0,8,0"
                        Command="{Binding ExportLibraryCommand}"
                        ToolTip="{loc:Loc export_desc}"/>
                <Button Style="{StaticResource Ghost}" Padding="10,6" Content="{loc:Loc import_btn}" Margin="0,0,8,0"
                        Command="{Binding ImportLibraryCommand}"
                        ToolTip="{loc:Loc import_desc}"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource Ghost}" Padding="10,6"
                        Content="{Binding DarkModeToggleLabel}"
                        Command="{Binding ToggleDarkModeCommand}"
                        ToolTip="{loc:Loc theme_desc}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="{loc:Loc lang_label}" VerticalAlignment="Center"/>
                    <ComboBox Width="130" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                              SelectedIndex="{Binding LanguageIndex}"
                              ToolTip="{loc:Loc lang_tooltip}">
                        <ComboBoxItem Content="{loc:Loc lang_auto}"/>
                        <ComboBoxItem Content="{loc:Loc lang_ja}"/>
                        <ComboBoxItem Content="{loc:Loc lang_en}"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 左レーン: 登録・実行 / 右レーン: 結果 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左レーン（登録・実行） ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 追加カード -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左: URL入力 -->
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc search_placeholder}"/>
                            <TextBox Style="{StaticResource Field}" Height="74" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- 右: 追加ボタン -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Width="150">
                            <Button Style="{StaticResource Accent}" Content="{loc:Loc add_btn}"
                                    Command="{Binding AddCommand}" Height="40"/>
                            <Button Style="{StaticResource Ghost}" Content="{loc:Loc CancelBtn}" Margin="0,8,0,0"
                                    Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- キーワード検索カード -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc search_title}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <TextBox Style="{StaticResource Field}" Width="330"
                                         IsEnabled="{Binding IsNotBusy}"
                                         Text="{Binding SearchSection.Keyword, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:Loc search_hint}"/>
                                <Button Style="{StaticResource Accent}" Content="{loc:Loc search_btn}" Margin="8,0,0,0" Padding="14,6"
                                        Command="{Binding SearchSection.SearchCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchSection.Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="2,5">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="{Binding IsSelected}"
                                                          IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Text="{Binding Title}" Width="240" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Author}" Width="100" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding EpisodesText}" Width="50" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SiteLabel}" Width="56" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding StatusBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Ghost}" Content="{loc:Loc select_all}" Padding="10,5" Margin="0,0,10,0"
                                    Command="{Binding SearchSection.SelectAllCommand}"/>
                            <Button Style="{StaticResource Accent}" Content="{loc:Loc download_btn}" Padding="12,6"
                                    Command="{Binding SearchSection.DownloadSelectedCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- オプション + フォルダ + 一括操作 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
                    <StackPanel>
                        <WrapPanel IsEnabled="{Binding IsNotBusy}">
                            <CheckBox Content="{loc:Loc vertical_writing}" IsChecked="{Binding EpubSettings.Vertical}" Margin="0,0,16,0"/>
                            <CheckBox Content="{loc:Loc include_illustrations}" IsChecked="{Binding EpubSettings.IncludeInlineImages}" Margin="0,0,16,0"/>
                            <CheckBox Content="{loc:Loc grayscale}" IsChecked="{Binding EpubSettings.GrayscaleImages}" Margin="0,0,16,0"/>
                            <CheckBox Content="{loc:Loc keep_ruby}" IsChecked="{Binding EpubSettings.KeepRuby}" Margin="0,0,16,0"/>
                            <CheckBox Content="{loc:Loc cover_auto}" IsChecked="{Binding EpubSettings.AutoCover}" Margin="0,0,16,0"
                                      ToolTip="{loc:Loc cover_auto_desc}"/>
                            <CheckBox Content="{loc:Loc proofread_title}" IsChecked="{Binding EpubSettings.EnableProofreading}" Margin="0,0,6,0"
                                      ToolTip="{loc:Loc proof_desc}"/>
                            <Button Style="{StaticResource Ghost}" Content="{loc:Loc rules_edit}" Padding="8,3" FontSize="11" Margin="0,0,24,0"
                                    Command="{Binding OpenProofreadingRulesCommand}"
                                    ToolTip="{loc:Loc rules_open_desc}"/>
                            <TextBlock Text="{loc:Loc split_per_file_label}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                            <TextBox Style="{StaticResource Field}" Width="64" Text="{Binding EpubSettings.EpisodesPerFile}" Margin="0,0,24,0"
                                     ToolTip="{loc:Loc epubs_per_part}"/>
                            <TextBlock Text="{loc:Loc interval_label}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                            <TextBox Style="{StaticResource Field}" Width="64" Text="{Binding EpubSettings.RequestDelayMs}"/>
                        </WrapPanel>

                        <Separator Margin="0,10" Background="{DynamicResource Border}"/>

                        <!-- XTC 出力設定 -->
                        <WrapPanel IsEnabled="{Binding IsNotBusy}">
                            <CheckBox Content="{loc:Loc also_generate_xtc}" IsChecked="{Binding XtcSettings.GenerateXtc}" Margin="0,0,16,0"
                                      VerticalAlignment="Center"
                                      ToolTip="{loc:Loc xtc_desc}"/>

                            <TextBlock Text="{loc:Loc device_label}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                            <ComboBox Width="180" Margin="0,0,8,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding XtcSettings.XtcDevices}"
                                      SelectedItem="{Binding XtcSettings.XtcDevice}"
                                      ToolTip="{loc:Loc resolution_desc}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static local:DeviceNameConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding XtcSettings.XtcResolutionText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,20,0"/>

                            <TextBlock Text="{loc:Loc col_font}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                            <ComboBox Width="200" Margin="0,0,8,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding XtcSettings.XtcFonts}"
                                      SelectedItem="{Binding XtcSettings.XtcFont}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="{loc:Loc font_desc}"/>
                            <Button Style="{StaticResource Ghost}" Content="{loc:Loc font_reference}" Padding="8,3" FontSize="11" Margin="0,0,20,0"
                                    Command="{Binding ChooseXtcFontCommand}"
                                    ToolTip="{loc:Loc font_manual_desc}"/>

                            <!-- ラベルと入力欄が離れて折り返さないよう、グループ単位でまとめる -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc text_size_label}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                                <TextBox Style="{StaticResource Field}" Width="52" FontSize="12" Padding="6,3"
                                         VerticalAlignment="Center"
                                         Text="{Binding XtcSettings.XtcFontSize, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:Loc font_size_desc}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc line_width_label}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                                <TextBox Style="{StaticResource Field}" Width="52" FontSize="12" Padding="6,3"
                                         VerticalAlignment="Center"
                                         Text="{Binding XtcSettings.XtcTextThreshold, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:Loc threshold_tooltip}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc margins_px}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:Loc m_top}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,3,0"/>
                                <TextBox Style="{StaticResource Field}" Width="42" FontSize="12" Padding="5,3"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Text="{Binding XtcSettings.XtcPaddingTop, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:Loc top_margin_desc}"/>
                                <TextBlock Text="{loc:Loc m_bottom}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,3,0"/>
                                <TextBox Style="{StaticResource Field}" Width="42" FontSize="12" Padding="5,3"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Text="{Binding XtcSettings.XtcPaddingBottom, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:Loc bottom_margin_desc}"/>
                                <TextBlock Text="{loc:Loc m_left}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,3,0"/>
                                <TextBox Style="{StaticResource Field}" Width="42" FontSize="12" Padding="5,3"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Text="{Binding XtcSettings.XtcPaddingLeft, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:Loc left_margin_desc}"/>
                                <TextBlock Text="{loc:Loc m_right}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,3,0"/>
                                <TextBox Style="{StaticResource Field}" Width="42" FontSize="12" Padding="5,3"
                                         VerticalAlignment="Center"
                                         Text="{Binding XtcSettings.XtcPaddingRight, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="{loc:Loc right_margin_desc}"/>
                            </StackPanel>

                            <Button Style="{StaticResource Ghost}" Content="{loc:Loc convert_all_btn}"
                                    Command="{Binding ConvertAllXtcCommand}"
                                    ToolTip="{loc:Loc convert_all_desc}"/>
                        </WrapPanel>

                        <Separator Margin="0,10" Background="{DynamicResource Border}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc save_to_label}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutputFolder}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolder}"/>
                            <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="{loc:Loc folder_btn}"
                                    Command="{Binding ChooseFolderCommand}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource Ghost}" Content="{Binding PickPendingCoversLabel}"
                                    Command="{Binding PickPendingCoversCommand}" Margin="0,0,8,0"
                                    ToolTip="{loc:Loc cover_unselected_desc}"/>
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="{loc:Loc check_updates_btn}"
                                    Command="{Binding CheckAllCommand}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Style="{StaticResource Accent}" Content="{loc:Loc update_btn}"
                                    Command="{Binding UpdateAllCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 進捗・ステータス -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                    <StackPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIndeterminate}"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- キュー（左下部） -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{Binding QueueStatusLine}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <ItemsControl ItemsSource="{Binding QueuePanelItems}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" FontSize="11"
                                               Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 右レーン（結果：作品リストのみ） ===== -->
            <Grid Grid.Column="2">
                <!-- ライブラリ一覧 -->
                <Border Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 並べ替えコントロール -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4,0,8">
                            <TextBlock Text="{loc:Loc sort_label}" FontSize="11" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton Style="{StaticResource SortRadio}" Content="{loc:Loc col_converted}"
                                         GroupName="LibSort" IsChecked="{Binding IsSortConverted}"/>
                            <RadioButton Style="{StaticResource SortRadio}" Content="{loc:Loc col_site_date}"
                                         GroupName="LibSort" IsChecked="{Binding IsSortSiteUpdated}"/>
                            <RadioButton Style="{StaticResource SortRadio}" Content="{loc:Loc col_title}"
                                         GroupName="LibSort" IsChecked="{Binding IsSortTitle}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="10" Margin="4" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 表紙サムネ -->
                                                <Border Grid.Column="0" Width="60" Height="84" CornerRadius="4"
                                                        Background="{DynamicResource AppBg}" Margin="0,0,14,0">
                                                    <Grid>
                                                        <TextBlock Text="{loc:Loc cover_simple}" Foreground="{DynamicResource Muted}" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>

                                                <!-- 情報 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- タイトル行 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       ToolTip="{Binding Title}"
                                                                       MouseLeftButtonDown="Title_MouseClick"
                                                                       Visibility="{Binding EditingTitle, Converter={x:Static local:BoolToVisibility.Instance}, ConverterParameter=invert}"/>
                                                            <TextBox Text="{Binding TitleEdit, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold"
                                                                       Padding="3,1" BorderBrush="#94A3B8" BorderThickness="1" VerticalAlignment="Center"
                                                                       Visibility="{Binding EditingTitle, Converter={x:Static local:BoolToVisibility.Instance}}"
                                                                       KeyDown="TitleEdit_KeyDown" LostFocus="TitleEdit_LostFocus"/>
                                                        </Grid>
                                                        <Border Grid.Column="1" Visibility="{Binding CompletedVisibility}" Background="#16A34A"
                                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:Loc col_completed}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Grid.Column="2" Visibility="{Binding CoverPendingVisibility}" Background="#EA580C"
                                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="{loc:Loc provisional_desc}">
                                                            <TextBlock Text="{loc:Loc cover_unselected}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Button Grid.Column="3" Style="{StaticResource Chip}" Content="📋" Padding="5,2" FontSize="12"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="{loc:Loc copy_title_tooltip}"
                                                                Command="{Binding DataContext.CopyTitleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <!-- サイト・著者・話数 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="{DynamicResource AccentBg}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding SiteLabel}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Author}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding EpisodesText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PartsText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- URL リンク -->
                                                    <TextBlock Margin="0,3,0,0" FontSize="11">
                                                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"
                                                                   Foreground="{DynamicResource AccentBrush}">
                                                            <Run Text="{Binding Url, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>

                                                    <!-- ステータスバッジ + 日付 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border CornerRadius="9" Padding="9,2" Background="{Binding StatusBrush}">
                                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding SiteUpdatedText}" Foreground="{DynamicResource Muted}"
                                                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding LastCheckedText}" Foreground="{DynamicResource Muted}"
                                                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding LastUpdatedText}" Foreground="{DynamicResource Muted}"
                                                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding QueueText}" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>

                                                    <!-- 出力ファイル名 -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{loc:Loc col_filename}" Foreground="{DynamicResource Muted}" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Style="{StaticResource Field}" Width="260" FontSize="12" Padding="6,3"
                                                                 Text="{Binding NameTemplateEdit, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="{loc:Loc placeholder_fmt}"/>
                                                        <Button Style="{StaticResource Chip}" Content="{loc:Loc rename_output}" Margin="6,0,0,0"
                                                                Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 操作 -->
                                                <WrapPanel Grid.Column="2" Width="270" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource Chip}" Content="{loc:Loc check_btn}" Margin="4"
                                                            Command="{Binding DataContext.CheckItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource Accent}" Content="{loc:Loc label_update}" Margin="4" Padding="11,5" FontSize="12"
                                                            Command="{Binding DataContext.UpdateItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource Chip}" Content="{Binding CoverButtonLabel}" Margin="4"
                                                            ToolTip="{loc:Loc cover_repick_desc}"
                                                            Command="{Binding DataContext.ChangeCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource Chip}" Content="XTC" Margin="4"
                                                            ToolTip="{loc:Loc convert_desc}"
                                                            Command="{Binding DataContext.ConvertXtcCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource Chip}" Content="{loc:Loc open_btn}" Margin="4"
                                                            Command="{Binding DataContext.OpenEpubCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource Chip}" Content="📁" Margin="4"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource Danger}" Content="{loc:Loc delete_btn}" Margin="4" Padding="9,5" FontSize="12"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空状態 -->
                        <TextBlock Grid.Row="1" Text="{loc:Loc empty_hint}"
                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Items.Count, Converter={x:Static local:CountToVisibility.Instance}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
