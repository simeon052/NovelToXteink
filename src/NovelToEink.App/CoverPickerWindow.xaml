<Window x:Class="NovelToEink.App.CoverPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="表紙を選ぶ"
        Height="700" Width="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="Yu Gothic UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubText" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            <TextBlock x:Name="SearchStatus" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource Ghost}" Content="📂 ファイルから追加" Padding="10,4"
                        Click="AddFromFile_Click"/>
                <TextBlock Text="または画像をウィンドウへドラッグ＆ドロップ / Ctrl+V で貼り付け"
                           Foreground="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Style="{StaticResource Ghost}" Click="Cancel_Click" MinWidth="100"/>
                <Button Content="この表紙で決定" Style="{StaticResource Accent}" Click="Ok_Click" MinWidth="140" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="CoverList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CoverList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="6" Padding="6" CornerRadius="8" Background="White"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <Border Height="190" Background="{StaticResource AppBg}" CornerRadius="4">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center"
                                               Margin="0,6,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
