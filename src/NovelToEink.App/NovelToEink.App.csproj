<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NovelToEink.Core\NovelToEink.Core.csproj" />
    <ProjectReference Include="..\NovelToEink.Xtc\NovelToEink.Xtc.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Self-contained only for Store packaging (MSIX bundles the .NET runtime;
         Store users otherwise need .NET 10 Desktop Runtime installed).
         Build via: msbuild NovelToEink.App.Packaging.wapproj /p:PackageForStore=true -->
    <RuntimeIdentifier Condition="'$(PackageForStore)' == 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PackageForStore)' == 'true'">true</SelfContained>
  </PropertyGroup>

</Project>
